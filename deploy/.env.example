# Copy to deploy/.env on the host. Never commit .env.

POSTGRES_USER=food
POSTGRES_PASSWORD=change-me
POSTGRES_DB=food

# Long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

# Vision providers, tried in order (any OpenAI-compatible endpoint).
VISION_PROVIDERS=[{"name":"local","url":"http://ollama:11434/v1","model":"qwen3-vl:4b-instruct"}]

# Cloudflare Zero Trust → Tunnels → food-buddy → token. Public hostname → http://caddy:80
CLOUDFLARE_TUNNEL_TOKEN=

# Port Caddy listens on (127.0.0.1 only)
HTTP_PORT=8080

# Images (CI pushes these); comment out to build locally
# API_IMAGE=ghcr.io/tomi-trost/food-buddy-api:latest
# WEB_IMAGE=ghcr.io/tomi-trost/food-buddy-web:latest
