# Copy to /etc/food-buddy/backup.env on the host (sudo install -m 600 -o root ...). Never commit it.

# Backblaze B2 (S3 API). Bucket: private, lifecycle "Keep only the last version".
# Endpoint is shown on the bucket page, e.g. s3.eu-central-003.backblazeb2.com
RESTIC_REPOSITORY=s3:https://s3.eu-central-003.backblazeb2.com/<bucket>/restic
# Application key restricted to that one bucket: keyID / applicationKey
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Encrypts the backups. Losing it means losing them: also keep it in a password manager.
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
RESTIC_PASSWORD=

# Stop uploading at this repository size (B2 free tier: 10 GB)
MAX_REPO_GB=8

# Optional: ping URL of a free healthchecks.io check (daily period) to get an email
# when a backup fails or doesn't run
HEALTHCHECK_URL=
